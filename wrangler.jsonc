{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-clinic",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "e0c7e7fb-4f2e-441c-a373-6b63319f22cc",
      "database_name": "clinic-db"
    }
  ]
}
